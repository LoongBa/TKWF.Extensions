{
  "TargetProject": "..\\..\\_Framework\\Permissions\\TKWF.Ext.Permissions.csproj",
  "EnableSkipUnchanged": true,
  "OutputRoot": "..\\..\\_Framework\\Permissions\\Generated",
  "TemplatesPath": "%TKWFDeployPath%\\xCodeGen\\Templates",

  "Artifacts": {
    "Entity": {
      "Scope": "Entity",
      "Template": "Entity.cshtml",
      "OutputPattern": "{ClassName}.g.cs",
      "OutputDir": "..\\..\\_Framework\\Permissions\\Entities",
      "SkeletonTemplate": "EntityEmpty.cshtml",
      "SkeletonPattern": "{ClassName}.biz.cs",
      "SkeletonDir": "..\\..\\_Framework\\Permissions\\Entities"
    },
    "Dto": {
      "Scope": "Entity",
      "Template": "Dto.cshtml",
      "OutputPattern": "{ClassName}Dto.g.cs",
      "OutputDir": "..\\..\\_Framework\\Permissions\\Entities\\DTOs",
      "SkeletonTemplate": "DtoEmpty.cshtml",
      "SkeletonPattern": "{ClassName}Dto.cs",
      "SkeletonDir": "..\\..\\_Framework\\Permissions\\Entities\\DTOs"
    },
    "Conditions": {
      "Scope": "Entity",
      "Template": "Conditions.cshtml",
      "OutputPattern": "{ClassName}Conditions.g.cs",
      "OutputDir": "..\\..\\_Framework\\Permissions\\Entities\\Conditions"
    },
    "DataService": {
      "Scope": "Entity",
      "Template": "DataService.cshtml",
      "OutputPattern": "{ClassName}DataService.g.cs",
      "OutputDir": "..\\..\\_Framework\\Permissions\\DataServices",
      "SkeletonTemplate": "DataServiceEmpty.cshtml",
      "SkeletonPattern": "{ClassName}DataService.cs",
      "SkeletonDir": "..\\..\\_Framework\\Permissions\\DataServices"
    }
  },

  "CustomSettings": {
    "EnableLogging": "true",
    "AutoManagedFields": "Id,CreateTime,UpdateTime,IsDeleted,TenantId,UId"
  }
}
