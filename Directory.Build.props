<Project>
  <PropertyGroup>
    <!--
      MinVer：从最近的 git tag 自动推导版本号。
      - git tag v4.9.6 → 版本 4.9.6
      - v4.9.6 之后有提交 → 版本 4.9.6-preview.N
      - 无 tag → 0.0.0-preview.N
    -->
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <Authors>LoongBa.cn 龙爸出品</Authors>
    <Company>LoongBa.cn</Company>

    <!-- 输出 XML 文档文件（NuGet 包需要、IDE 智能提示需要） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 抑制"公共成员缺少 XML 注释"警告，不强迫为全量 API 写注释 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet 打包公共属性 -->
    <RepositoryUrl>https://github.com/LoongBa/TKWF.Extensions</RepositoryUrl>
    <PackageTags>TKWF;Extension;LoongBa</PackageTags>
    <Copyright>Copyright © LoongBa.cn 2026</Copyright>
    <!-- 包页面显示仓库根 README（2026-09-15 补：此前 Pack 打包 README 但未声明 PackageReadmeFile→NuGet 警告"缺少自述文件"且不显示） -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 许可证声明（2026-09-15 补：首 30 包发布时 nuget.org 提示 License missing——仓库 LICENSE 为 Apache-2.0） -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    定义 TKWFSourceRoot：相对路径指向主框架 _TKWF（与本仓库同级），不依赖环境变量。
    扩展包通过 $(TKWFSourceRoot)_Framework\... ProjectReference 引用主框架源码。
    TKWFDeployPath：部署根（从环境变量 TKWFDeployPath 规范化，Dll 模式 refs 使用）。
    （对齐 DMP-Lite 的跨仓库引用模式）
  -->
  <PropertyGroup>
    <TKWFSourceRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)..\_TKWF\'))</TKWFSourceRoot>
    <TKWFDeployPath>$([MSBuild]::EnsureTrailingSlash('$(TKWFDeployPath)'))</TKWFDeployPath>
  </PropertyGroup>

  <!--
    ════════════════════════════════════════════════════════════════════════
    双模式引用开关（2026-09-16 用户裁定，方案 B 定案为 DLL 模式）：
    UseLocalFw = true  → 本地联调模式（默认）：DLL 引用部署根 build\refs（TKWFDeployPath）
                         ——对齐消费方（DMP-Lite）DLL 模式，零跨仓库源码耦合（不 ProjectReference 源码）
    UseLocalFw = false → NuGet 发布模式：PackageReference 主框架 NuGet 包
                         ——CI/发布走此模式，验证真实消费方视角（2026-09-15 迁移后的默认 CI 语义）

    实现：不导入主框架 TKWF.Domain.targets（其会无条件注入 build/refs 的 Analyzer，
    与扩展纯 Analyzer NuGet 包冲突——Roslyn 增量缓存 bug，AGENTS §6 裁定废弃 build/refs 预编译 DLL）。
    仅自建 DLL 引用块（下方 _LocalFwRefsDir），SG1 分析器恒用纯 Analyzer 包（TKWF.CodeGeneration）。

    优先级：命令行/环境变量 UseLocalFw > 默认 true（本地开发零配置）。
    CI workflow 显式设 UseLocalFw=false（ci-publish.yml env）。
    扩展 csproj 引用块按此开关条件化（见各 csproj）：
      Condition="'$(UseLocalFw)' == 'true'" → Reference HintPath（DLL 模式）
      Condition="'$(UseLocalFw)' != 'true'" → PackageReference（NuGet 模式）
    ════════════════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <UseLocalFw Condition="'$(UseLocalFw)' == ''">true</UseLocalFw>
    <!-- DLL 模式引用目录：部署根 build\refs（TKWFDeployPath 环境变量，对齐消费方 DMP-Lite）。
         V4.10.30 修复：EnsureTrailingSlash 规范化（原 GetFullPath 返回尾部 \ + 再拼 \build\refs\ → 双反斜杠，
         HintPath 解析失败——测试项目直接 Reference 时 CS0246 实证） -->
    <_LocalFwRefsDir Condition="'$(TKWFDeployPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(TKWFDeployPath)'))build\refs\</_LocalFwRefsDir>
  </PropertyGroup>

  <!--
    DLL 模式集中引用（UseLocalFw=true）：主框架通用核心程序集（所有扩展共用——
    Core/Utility/Abstractions/Domain）。SG1 分析器（TKWF.CodeGeneration）不在此（各扩展
    PackageReference 纯 Analyzer 包，Roslyn 增量缓存正确性）。
    ⚠️ Domain.FreeSql / CodeGeneration.Abstractions / 扩展特定包（BackgroundJobs/DataPort 等）：
    由各扩展 csproj 按需条件化声明（实体型扩展才引 FreeSql；纯内存扩展不引）——
    集中块仅承载"所有扩展都引"的核心，避免污染。
    扩展 csproj 内主框架引用条件化模式（样板）：
      <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
      <Reference Include="TKWF.Domain" HintPath="$(_LocalFwRefsDir)TKWF.Domain.dll" Condition="'$(UseLocalFw)' == 'true'" />
  -->
  <ItemGroup Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.dll')">
    <Reference Include="TKWF.Core" HintPath="$(_LocalFwRefsDir)TKWF.Core.dll" />
    <Reference Include="TKWF.Utility" HintPath="$(_LocalFwRefsDir)TKWF.Utility.dll" />
    <Reference Include="TKWF.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.Abstractions.dll" />
    <Reference Include="TKWF.Domain" HintPath="$(_LocalFwRefsDir)TKWF.Domain.dll" />
    <!-- DLL 模式 RT 引用不传递 NuGet 依赖——显式补齐运行时传递依赖（对齐主框架 targets 做法） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    MinVer 包：编译期版本推导，不产生运行时依赖。
    版本号由父级 Directory.Packages.props 中的 CPM 统一管理。
  -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    _PushToRefs: 编译后自动推送 DLL 到 refs\，供消费者 DLL 模式引用。
    对齐主框架 _TKWF 的 _PushToRefs 机制。

    V4.9.106：推送目标改为部署根 build\refs（TKWFDeployPath，真实复制）——
    扩展 DLL 与主框架 DLL 统一进部署包 build\refs，消费端统一经环境变量引用（去 junction）；
    未设置环境变量时 fallback 本仓库 build\refs（独立构建场景，消费者经 $(TKWExtRoot) 引用）。
  -->
  <Target Name="_PushToRefs" AfterTargets="Build" Condition="'$(TargetFramework)' != '' And '$(NoBuild)' != 'true'">
    <PropertyGroup>
      <!-- 优先部署根环境变量（去软链、真实复制），fallback 本仓库 build\refs -->
      <_RefsDir Condition="'$(TKWFDeployPath)' != ''">$([System.IO.Path]::GetFullPath('$(TKWFDeployPath)'))\build\refs\</_RefsDir>
      <_RefsDir Condition="'$(_RefsDir)' == ''">$(MSBuildThisFileDirectory)build\refs\</_RefsDir>
      <!-- BUG004 (v4.10.17): 源码树 refs 双写——消费端（DMP-Lite 等）经 $(TKWExtRoot)build\refs 引用扩展 DLL，
           仅推部署 refs 时本仓库 refs 陈旧（CS0436 复现根因之一）；TKWFDeployPath 设置时同时推本仓库 refs。
           未设置环境变量时 _RefsDir 已指向本仓库 refs，避免重复复制。 -->
      <_RefsDirSource Condition="'$(TKWFDeployPath)' != ''">$(MSBuildThisFileDirectory)build\refs\</_RefsDirSource>
    </PropertyGroup>
    <MakeDir Directories="$(_RefsDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(_RefsDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
          DestinationFolder="$(_RefsDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).xml')" />
    <!-- 双写：本仓库源码树 refs（消费端引用点） -->
    <MakeDir Directories="$(_RefsDirSource)" Condition="'$(_RefsDirSource)' != ''" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(_RefsDirSource)"
          SkipUnchangedFiles="true"
          Condition="'$(_RefsDirSource)' != ''" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
          DestinationFolder="$(_RefsDirSource)"
          SkipUnchangedFiles="true"
          Condition="'$(_RefsDirSource)' != '' And Exists('$(TargetDir)$(TargetName).xml')" />
  </Target>
</Project>