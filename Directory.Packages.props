<Project>
  <!--
    ════════════════════════════════════════════════════════════
    集中包版本管理（Central Package Management）
    TKWF.Extensions 扩展仓库独立 CPM 文件。

    主框架（_TKWF）包版本以 ProjectReference 方式引用，不在此重复。
    此处仅管理扩展仓库自身所需的外部包。
    ════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- 构建工具 -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Microsoft Extensions（扩展常需 Options/DI/Caching） -->
    <!-- Quartz 4.0.0 传递依赖 Microsoft.Extensions 10.0.11，CPM 对齐提升 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- DLL 模式（UseLocalFw=true）Reference 不传递 NuGet 依赖——主框架 Domain 的运行时传递依赖需显式声明
         （System.Threading.RateLimiting，V4.9.26 官方类型，对齐主框架 TKWF.Domain.targets 做法） -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <!-- UseWebSession（Web 扩展冒烟测试全链宿主）运行时依赖——TKWF.Domain.Web 内 AddHybridCache 调用；
         DLL 模式 Reference 不传递 NuGet 依赖，测试项目须显式包（对齐主框架 CPM 版本 10.8.0） -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <!-- 实体声明式（FreeSql [Column] 特性），对齐主框架 _TKWF CPM 版本 -->
    <PackageVersion Include="FreeSql" Version="3.5.311" />
    <PackageVersion Include="FreeSql.DbContext" Version="3.5.311" />
    <PackageVersion Include="FreeSql.Extensions.Linq" Version="3.5.311" />
    <PackageVersion Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <!-- 邮件发送（MailKit SMTP 实现库） -->
    <PackageVersion Include="MailKit" Version="4.12.1" />
    <!-- Scriban（打印模板引擎——PrintTemplates 扩展首个非存储类第三方运行时依赖，ADR 已裁定选型） -->
    <PackageVersion Include="Scriban" Version="7.0.0" />
    <!-- Roslyn Analyzer（编译期权限名校验——扩展侧 DiagnosticAnalyzer，对齐主框架 CPM 版本） -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!-- Quartz — 后台作业调度器（BackgroundJobs 扩展 Part C，对齐主框架 CPM 版本 4.0.0） -->
    <PackageVersion Include="Quartz" Version="4.0.0" />
    <!-- Microsoft.Data.Sqlite — Quartz 4.0 UseSqlite 内部需要的 SQLite 驱动元数据 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
<!-- MiniExcel — DataPort MiniExcel Provider 的第三方读写引擎（DLL 模式 Reference 不传递 NuGet 依赖，测试项目须显式包） -->
<PackageVersion Include="MiniExcel" Version="1.46.0" />
    <!-- Microsoft.AspNetCore.TestHost — ASP.NET Core 测试宿主（RateLimiting 测试 HTTP 级验证，对齐 Microsoft.Extensions 10.0.11） -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- ════════════════════════════════════════════════════════
         主框架 TKWF.* 包（2026-09-15 迁移：ProjectReference → PackageReference）
         版本对齐主框架已发布稳定版 4.10.50（EduPlatform 转达·扩展 DataService 聚合缺陷根治——SG1 生成器
         GetOrCreateInstance 按类型隔离 _instance 静态槽，扩展不再共享基类 Instance；BUG007 WASM 兼容——
         AUTH_REQUIRED 改 DomainException{ErrorCode=AUTH_REQUIRED}；上一版 4.10.46 BUG005 纯修复），见 AGENTS §6 注记）；
         主框架发新版后同步提升。
         TKWF.CodeGeneration 为纯 Analyzer 包（analyzers/dotnet/cs/，无 lib/），
         消费侧声明后 Roslyn 自动加载，无需 <Analyzer> 元素。
         ════════════════════════════════════════════════════════ -->
    <PackageVersion Include="TKWF.Domain" Version="4.10.52" />
    <PackageVersion Include="TKWF.Utility" Version="4.10.52" />
    <PackageVersion Include="TKWF.Core" Version="4.10.52" />
    <PackageVersion Include="TKWF.Abstractions" Version="4.10.52" />
    <PackageVersion Include="TKWF.BackgroundJobs" Version="4.10.52" />
    <PackageVersion Include="TKWF.BackgroundJobs.Quartz" Version="4.10.52" />
    <PackageVersion Include="TKWF.Utility.DataPort" Version="4.10.52" />
    <PackageVersion Include="TKWF.Utility.DataPort.Providers.MiniExcel" Version="4.10.52" />
    <PackageVersion Include="TKWF.Domain.FreeSql" Version="4.10.52" />
    <!-- ✅ Web 装配钩子（v4.10.45，ADR87）：Web 类扩展以 IWebExtension 三阶段自描述 Web 装配需求——
         4 个 Web 接线先例（Authentication/RateLimiting/HealthCheck/Notifications.SignalR）收敛迁移的前置引用 -->
    <PackageVersion Include="TKWF.Domain.Web" Version="4.10.52" />
    <!-- ✅ 4.10.52 lockstep（2026-10-03）：主框架 4.10.52 已发布（ADR89 IEntityDAC 条件原子更新原语
         UpdateWhereAsync——响应扩展组转达 docs/转达-MFA原子条件更新能力缺口-请框架组裁定.md，方案 A 落地；
         MFA B 批 IFreeSql 逃生口移除 + Outbox InboxDbVersionStore 非原子 RMW 根治 + xCodeGen 模板增
         EntityUpdateWhereAsync 转发器；另含 v4.10.51 ADR88 构造注入门控 DI004/DI005 诊断） -->
  <PackageVersion Include="TKWF.CodeGeneration" Version="4.10.52" />
  <PackageVersion Include="TKWF.CodeGeneration.Abstractions" Version="4.10.52" />
  </ItemGroup>
</Project>