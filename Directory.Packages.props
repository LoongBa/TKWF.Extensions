<Project>
  <!--
    ════════════════════════════════════════════════════════════
    集中包版本管理（Central Package Management）
    TKWF.Extensions 扩展仓库独立 CPM 文件。

    主框架（_TKWF）包版本以 ProjectReference 方式引用，不在此重复。
    此处仅管理扩展仓库自身所需的外部包。
    ════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- 构建工具 -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Microsoft Extensions（扩展常需 Options/DI/Caching） -->
    <!-- Quartz 4.0.0 传递依赖 Microsoft.Extensions 10.0.11，CPM 对齐提升 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- DLL 模式（UseLocalFw=true）Reference 不传递 NuGet 依赖——主框架 Domain 的运行时传递依赖需显式声明
         （System.Threading.RateLimiting，V4.9.26 官方类型，对齐主框架 TKWF.Domain.targets 做法） -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <!-- TKWF.Federation.WeChat 平台网关库（纯库——出站 API 客户端 HttpClient 注入 IHttpClientFactory，Oracle 评审点 5 不引 AspNetCore） -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- UseWebSession（Web 扩展冒烟测试全链宿主）运行时依赖——TKWF.Domain.Web 内 AddHybridCache 调用；
         DLL 模式 Reference 不传递 NuGet 依赖，测试项目须显式包（对齐主框架 CPM 版本 10.8.0） -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <!-- 实体声明式（FreeSql [Column] 特性），对齐主框架 _TKWF CPM 版本 -->
    <PackageVersion Include="FreeSql" Version="3.5.311" />
    <PackageVersion Include="FreeSql.DbContext" Version="3.5.311" />
    <PackageVersion Include="FreeSql.Extensions.Linq" Version="3.5.311" />
    <PackageVersion Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <!-- 邮件发送（MailKit SMTP 实现库） -->
    <PackageVersion Include="MailKit" Version="4.12.1" />
    <!-- Scriban（打印模板引擎——PrintTemplates 扩展首个非存储类第三方运行时依赖，ADR 已裁定选型） -->
    <PackageVersion Include="Scriban" Version="7.0.0" />
    <!-- Roslyn Analyzer（编译期权限名校验——扩展侧 DiagnosticAnalyzer，对齐主框架 CPM 版本） -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!-- Quartz — 后台作业调度器（BackgroundJobs 扩展 Part C，对齐主框架 CPM 版本 4.0.0） -->
    <PackageVersion Include="Quartz" Version="4.0.0" />
    <!-- Microsoft.Data.Sqlite — Quartz 4.0 UseSqlite 内部需要的 SQLite 驱动元数据 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
<!-- MiniExcel — DataPort MiniExcel Provider 的第三方读写引擎（DLL 模式 Reference 不传递 NuGet 依赖，测试项目须显式包） -->
<PackageVersion Include="MiniExcel" Version="1.46.0" />
    <!-- Microsoft.AspNetCore.TestHost — ASP.NET Core 测试宿主（RateLimiting 测试 HTTP 级验证，对齐 Microsoft.Extensions 10.0.11） -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- ════════════════════════════════════════════════════════
         主框架 TKWF.* 包（2026-09-15 迁移：ProjectReference → PackageReference）
         ⚠️ 历史批次注记（当前 lockstep = **4.10.99**——nuget.org 13 包 4.10.99 已上架；v4.10.99 为
          **控制台/CLI 宿主移除 EventLog 默认注册**（DMP-Lite 转达——.NET 10 宿主无条件 `AddEventLog()`
          致非管理员环境 Warning 门控日志触发 EventLog 写路径 Win32Exception 崩溃；`ConfigConsoleDomain`
          开头按 `ImplementationType == typeof(EventLogLoggerProvider)` 过滤删除描述符——**不得用
          `RemoveAll<T>`**（按 ServiceType 匹配对 ILoggerProvider 默认注册永不命中，一审 B1 陷阱）；
          Web 宿主不动，非管理员 Web 隐患登记后续跟踪；扩展侧适配 = **CPM lockstep 即完成（零代码**
          **改动——行为自动修复）**，测试宿主不走 ConfigConsoleDomain 不受影响；4.10.98 被并行迭代
          《SG 测试项目内并行化》占用顺延）。前批 4.10.97（ADR117/ADR118 扩展门面
         不进消费方 ApiMetadata 结构性 bug 的框架侧修复收官：InterfaceNames 符号回填真名 + 扩展侧产契约接口 +
         手写门面判定放宽（`IAopContract` 或 `IDomainService` 均接受）+ DataService 缺口根治 + TUSER001/EXTIFACE001
         零猜测守卫。扩展侧适配：CPM lockstep 即完成（门面保持 `: IDomainService`——用户裁定语义修正，ADR118
         决策 4 两者均接受，零代码改动）；重建后生成物 InterfaceNames 真名（无 `.Controllers` 假名）+ 新契约接口
         生成物（`{扩展根Ns}.I{X} : IDomainService`）；消费方重编应零 WARN007/TUSER001/EXTIFACE001。
         4.10.93（2026-10-28——ControllerGenerator 数组特性参数 CS8785 崩溃修复：`[RequirePermission(params string[])]`
         等数组 TypedConstant 致消费方聚合扩展门面进控制器生成即崩（DMP 4.10.92 ADR118 适配第 1 项 Domain 编译阻塞）；
         `CreateTypedArg` Array 分支（`.Values` 递归展开 `new[] { ... }`/`new T[0]`）+ `FindApiExposeOnSymbol` 复用
         + `FormatLiteral` Array case；纯生成器修复，扩展/消费方零代码适配；lockstep 即解除 DMP 编译阻塞）。
         4.10.94（2026-10-28——扩展门面装饰器 **CS0535 修复**（ADR118 消费方产物命名口径）：`GenerateDecorator`
         声明扩展契约接口（成员保留 `Async`）却用 `ResolverMethodName`（剥离 `Async`）做方法签名 → 消费方
         CS0535 ×35（8 个扩展门面装饰器）；修复 = **装饰器声明名取契约接口成员名（`MethodName`，含 Async），
         转发调用与 `InvocationContext` 名仍取控制器名（剥离）**——AOP 门控/日志/事务语义不变；同源第二处
         （`GenerateExtensionFacadeInterface` 成员名亦用剥离名，致**无手写门面**的扩展项目自身 CS0535）+ 静默缺口
         （`Execute` 的 `targets.IsEmpty` 分支从不生成扩展消费方控制器/装饰器，P7）一并修复；框架自身生成物零变化；
         扩展侧适配 = **lockstep + 全量重建**（生成物命名口径变更，无源码改写；有手写门面扩展零改动——其成员本就含
         `Async`，与本次声明同口径）。
         4.10.95（2026-10-28——**能力清单假名 + 级联 TUSER001 修复**（DMP 4.10.94 回执第三轮：WebApi 2 Error +
         1 Warn + WARN004×12）：① **假名 WARN007/ERR002**——SG2 读 `GeneratedControllerRegistrations.InterfaceNames`，
         其发射处（`GenerateRegistrationContext`）另有内联推导 `{ControllerNamespace}.{GetInterfaceName}`（`AuthController`
         推成 `IAuthService`），而 A 路径真名早已存入 `TargetInfo.InterfaceName` 未被使用（P2 双推导链）→ 新增
         `GetAuthoritativeInterfaceName` 统一三处 + 注册发射改单次配对遍历（顺带消除 O(n²) 与同名歧义）+ 删除死代码
         `CollectAllTypesInNamespace`/`TryGetNamespaceTypes`；② **级联 TUSER001**——真实发射点 `ResolveFrameworkContractMetadata`
         （框架契约补充路径）无元数据入口 → `TUserHostResolver.Resolve` 仅遍历当前编译单元（WebApi 无宿主，声明在
         Domain）→ 0 候选；修法 = `TryResolveFromGeneratedRegistrations` 返回权威 `TUserFullName` 并传入，该路径 TUser
         优先级改 **元数据 → 控制器基类 → 宿主声明**（与 `ExtractFromContractInterface` 同序）；③ **fail-closed 未放宽**
         （元数据缺失仍报 TUSER001，不引入猜测）；框架侧验证 Domain.SG 302/302 · ApiService.SG 136/136 + 双向有效性。
         扩展侧适配 = lockstep + 全量重建（注册常量内容变化，必须重建）。
         4.10.96（2026-10-28——**门面排除集缺陷与端点缺失修复**（ADR120，回应本仓 `转达-扩展无手写门面形态命名口径残留
         致FeatureManagement端点缺失-请框架组修复.md`）：① **排除集单源**——三个框架类型全名（`IDomainService` /
         `IGeneratedByxCodeGenSG` / `IGeneratedByxCodeGenCli`）提升至 `FrameworkTypes`，`IsFrameworkFacadeBase` 改为集合
         比对并**删除旧命名空间字符串** `TKW.Framework.Domain.IDomainService`（全仓零定义的 typo，保留只会掩盖漂移）；
         自动覆盖 `GeneratedControllerCatalog.InterfaceNames` / B4 `RestRegisteredFacades` / 端点 `Facade` 全名（同源于
         `FindFacadeInterface`）→ 「无手写门面」目标回退 `{ServiceNamespace}.{InterfaceName}`（与 ExtI 同源，恒真名）；
         ② **静默 → 可见**——消费方 SG2 遇「已解析但非契约」条目（基接口/marker 被写入注册）此前无诊断直接跳过，现报
         `TKWF_SG2a_WARN008`（Warning，按程序集+类型去重；消息含类型名/来源程序集/重建指引）；③ **本仓转达根因③被证伪**——
         注册发射对扩展项目不可达（ADR94 起扩展不生成空壳 `GeneratedControllerRegistrations`），本仓观察到的
         `.Controllers` 注册文件为 10-25 旧 SDK 遗留产物（时间戳复核，`dotnet clean` 后消失）；④ VEntity 查询根字段与
         服务 resolver 同名合并 → 独立立项（非同源）；框架侧验证 Domain.SG 303/303 · ApiService.SG 137/137 + 双向有效性。
         扩展侧适配 = **lockstep + `dotnet clean` + 全量重建**（分析器恒 NuGet 包——必须等 4.10.96 上架后重建才生效）。
         ⚠️ **WARN004 为预期行为**（非缺陷）：同 GraphQL 根类型下多服务同名方法（`List`/`Save`/`Delete`/`ListRules`）→
         第一轮加服务短名前缀 `{服务短名}_{方法名}` 并报 WARN004（每冲突组 1 条）；仍冲突则第二轮全类型名前缀 +
         WARN005；编译期确定性消歧，SG3 客户端方法名跟随消歧后字段名。
         4.10.97（2026-10-28——**无手写门面三件套闭包 + SG3 桩命名空间**（ADR121 / ADR122）：① **ADR121**——
         同一类目标的控制器/装饰器/实现类注册三件套此前静默缺失（`FindExtensionImplementation` 只认「类显式实现接口」，
         而该类接口由 SG1b 派生 → `impl == null` → 跳过）；修法两段：`GeneratedControllerCatalog` 新增
         **`ImplementationTypes`**（与 `InterfaceNames` 索引对齐，消费方纯读解析；命名约定仅作旧包回退，均不命中报新诊断
         **`TKWF_SG1b_EXTIMPL001`** Warning）+ 扩展来源目标额外发射 `MetaType.Service` 注册（控制器经
         `user.Use<实现类>()` 取真实服务；`TryAdd` 与扩展 `AddConstructibleService` 去重）；② **ADR122**——SG3
         `GenerateDtoStubs` 此前无条件拼 `{ns}.Api`，而 SG2 `AppendApiSuffixToType` 对 `TKW*` 前缀不追加 `.Api`
         → 扩展类型桩落 `...FeatureManagement.Api` 致消费方引用原命名空间 CS0246；修复 = 桩命名空间取元数据原值
         （`.Api` 类型输出逐字节等价，有 T6 护栏）；③ 框架侧验证 Domain.SG 306/306 · ApiClient.SG 38/38 ·
         ApiService.SG 137/137 + 双向有效性。扩展侧适配 = **lockstep + 全量重建**（catalog 新常量；扩展包须用
         ≥4.10.97 SDK 重建才能被新消费方读到 `ImplementationTypes`）；**旧包回退前提**：无手写门面目标的实现类须
         `public`、非抽象、继承 `DomainServiceBase`、与接口同命名空间——本仓 7 个 ExtI 目标已逐项核验符合。
         ⚠️ **桥接历史（2026-10-28）**：4.10.89 曾因 SG3 发射 partial GeneratedJsonContext 致 CS0534 被跳过；
         4.10.90（RestTypeInfoRegistry 闭集注册表修复）曾暂锁；**4.10.91（ADR117）不可锁**——门面判定仍只认
         `IAopContract`，对 `: IDomainService` 门面无效（框架组自述"旧严格判定致 ADR117 修复对其无效"）；
         **4.10.92（ADR118）**——扩展侧产契约接口 + 消费方补生成控制器 + TUser 宿主声明单一权威（TUSER001
         Error，删 UserInfo 后缀猜测）+ 手写门面判定放宽（IAopContract 或 IDomainService 均接受）；
         契约接口基类最终定稿 **IDomainService**（用户裁定 2026-10-28：语义逻辑角度 IDomainService 更合适——
         领域服务能力声明 vs IAopContract 控制器契约标记；框架组 291ef43a 落地 + 重打 tag）。
         v4.10.91（2026-10-28——ADR117：`GenerateControllerCatalog.InterfaceNames` 符号回填真名（废弃
         `{ControllerNamespace}.{GetInterfaceName}` 拼接假名——扩展门面手写接口在根命名空间 `.Controllers`
         假名指向不存在类型致 SG2 `GetTypeByMetadataName` null 静默跳过）+ SG2 解析失败报诊断
         `TKWF_SG2a_WARN007`（Warning，[TKWFSeverity] 可升级）+ OPT003 取首段（三段式分层节 `TKWF:{Ext}:{Sub}`
         不再误报）。⚠️ 门面判定未放宽——对 `: IDomainService` 门面无效，**跳过本版**。
         v4.10.90（2026-10-28——ADR116 决策 1 修订：SG3 发射 `RestTypeInfoRegistrar`（[ModuleInitializer] 闭集注册表）+
         `RestTypeInfoRegistry.Register/Resolve`（烘焙 DefaultJsonTypeInfoResolver + JsonSerializerDefaults.Web）；
         零配置（ModuleInitializer 自动执行）；替代 4.10.89 损坏的 GeneratedJsonContext 发射；AOT 路径 Phase 2 预告
         （裁剪消费端当前 fail-closed）。扩展侧适配：CPM lockstep 即完成（扩展主包不直接消费 RestTypeInfoRegistry）。
         v4.10.89（2026-10-28——ADR112 让路守卫修复收官 C-3/C-4 批次，**nuget.org 已发布但 CS0534 阻塞即被 4.10.90 替代**——
         C-3 路由元数据 ADR115：`GeneratedControllerCatalog.RestEndpoint*` 四常量 + `ModuleKey/ModuleDefaultPrefix`；
         ApiMetadata 增 `RestMethod/RestRoute`（编译期组内相对路由 + 运行期组前缀，配置优先默认回退）；
         C-4 SG3 REST 传输分支 ADR116：`IRestApiClient`+`SendRestAsync`（非泛型 JsonTypeInfo 零反射 AOT 安全）+
         双传输分派 + WASM 缺客户端 fail-closed。扩展侧适配：扩展主包 csproj 若消费新 API 需同步；
         客户端注册 `TKWF.Domain.ApiClient.Rest`（AddRestApiClient + ModulePrefixResolver）。）
         v4.10.88（2026-10-28——ADR112 让路守卫精细化（框架组裁决 P1 批次）——
         C-1 per-interface 守卫（`GeneratedControllerCatalog.RestRegisteredFacades`——SG1b 与 B4 dispatcher 同源回填，
         修复程序集级守卫致 DataService 整域失踪的连带伤害）+ C-2 三关注点分离（REST 让路 / GraphQL resolver +
         ApiMetadata 保留标记 `IsSelfRegisteredRest`——扩展门面恢复进消费方 ApiMetadata → SG3 GraphQL 客户端恢复）+
         C-5 B4 发射条件对齐 ADR113（!IsQueryable）+ 缺省守卫 `TKWF_SG2a_EXTENDPOINT001`（Warning，旧版扩展提示升级）。
         扩展侧适配：CPM lockstep 后扩展门面将重新出现在消费方 ApiMetadata（SG3 GraphQL 客户端恢复）；
         旧版扩展包（<4.10.88 CodeGeneration 构建）会收 `TKWF_SG2a_EXTENDPOINT001` 升级即消除）。
         v4.10.87（2026-10-27——SG2 ApiMetadata 暴露面口径修正 ADR113：`IsExposed` 由「返回类型可映射」
         改为「可映射 &&（GraphQL 通道 || REST 通道）」——已标 `[ApiExpose(ExposeGraphQL=false,
         ExposeRest=false)]` 的方法不再被 SG3 生成客户端代理（旧行为误生成不可调用代理）。扩展侧影响：
         仅 SG3 客户端代理方法可能减少（本不该存在的方法），无契约/字段/配置/数据迁移，零代码适配）。
         v4.10.86（2026-10-27——Web 异常边界 ADR111：`DomainWebOptions.DevRethrowUnknownExceptions`
         新增（默认 true——Development 未知异常 rethrow 交框架头 DevPage）+ `WebAppBuilder` 自动注册
         `UseDeveloperExceptionPage()`（消费方勿再手动挂）。扩展侧影响：本仓零 `UseDeveloperExceptionPage`
         / 零 `DevRethrowUnknownExceptions` 引用 → 零适配；生产行为不变）。
         v4.10.80（2026-10-17——v4.10.80 稳健性修复批次：
         IdTokenDecoder FormatException 转译 C-1 闭环（验签失败契约全为 OAuthProtocolException，无破坏）/
         MemoryRateLimitCheck 竞态修复（行为等价）/ InboxCleanupService 启动自检（自定义 Inbox 表名不一致
         启动抛——扩展侧零使用，无影响）/ CI run 历史清理。**v4.10.79 票据有界配额 ADR110 已含**
         （SealedTicketOptions 增 MaxRedeems=1（第 4 位置参数，源兼容；<1 守卫抛）/ InMemorySealedTicketService
         TicketEntry record→可变类 + Interlocked.Increment 计数（并发恰 N 次成功）+ claimant 前置 CAS
         （错误核销人不烧槽位）+ Cleanup 扩展（过期/耗尽统一清理）/ ISealedTicketService 契约承诺更新：
         "原子单次消费"→"原子逐次消费（有界配额）"）。
         扩展侧适配（TrustCenter v0.3.2）：CPM lockstep + TKWF_SealedTicket 加 UsedCount/MaxRedeems 列
         + Redeem 改原子 UPDATE（SET UsedCount=UsedCount+1 WHERE UsedCount<MaxRedeems）
         + Cleanup 判据加耗尽。
         历史：v4.10.74（2026-10-14 外部身份联邦与会话绑定守卫 ADR107——D1 会话身份绑定守卫 /
         D2 枚举 Federated=7 / D3 FederatedIdentity POCO / D4 OnLoginByFederatedAsync 钩子 /
         D5 LoginAsFederatedAsync + ISealedTicketService<T> 密封票据原语（InMemory 后端 + TryRemove 原子）；
         扩展侧 E1-E3 适配；⚠️ 本地 DLL 模式掩盖 NuGet restore 时序（CI 曾因 CPM 4.10.72 restore 编译失败
         CS0246 FederatedIdentity 不存在——上架后 lockstep 解除，复验全绿））。
          本地 DLL 模式消费部署根 build\refs（UseLocalFw=true 零 restore，部署根已至 4.10.92 构建产物
          ——含 ADR117/ADR118 全部修复：InterfaceNames 符号回填 + WARN007 + IDomainService 判定放宽；
          ⚠️ 注意 refs 的 FileVersion 可能显示 4.10.91（MinVer 标注滞后），以二进制内容为准（UTF-16 实证）。
         TKWF.CodeGeneration 为纯 Analyzer 包（analyzers/dotnet/cs/，无 lib/），
         消费侧声明后 Roslyn 自动加载，无需 <Analyzer> 元素。
         ════════════════════════════════════════════════════════ -->
