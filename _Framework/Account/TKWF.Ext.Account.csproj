<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Account</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Account/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Account</PackageId>
    <Description>TKWF 扩展：账户管理与安全策略（账户锁定 + 密码重置流程默认实现）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主框架引用（跨仓库，TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Domain\TKWF.Domain.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Core\TKWF.Core.csproj" />

    <!-- V0.3.0 拆包（用户裁定 B）：账户契约抽象（IAccountPasswordManager）→ Abstractions（ADR48 D7） -->
    <ProjectReference Include="..\Account.Abstractions\TKWF.Ext.Account.Abstractions.csproj" />

    <!-- V0.3.0 登录历史与异常检测：消费 SecurityLog 扩展查询 API（SecurityLog 是登录历史唯一数据源，
         不重复建表——跨扩展走契约服务；SecurityLog 无 Abstractions 项目，直接引本体） -->
    <ProjectReference Include="..\SecurityLog\TKWF.Ext.SecurityLog.csproj" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集） -->
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration.Abstractions\TKWF.CodeGeneration.Abstractions.csproj" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行） -->
    <Analyzer Include="$(TKWFSourceRoot)build\refs\TKWF.CodeGeneration.dll" />
    <Analyzer Include="$(TKWFSourceRoot)build\refs\TKWF.CodeGeneration.Abstractions.dll" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration\TKWF.CodeGeneration.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\account.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（FreeSqlAccountLockoutStore、FreeSqlPasswordResetStore、FreeSqlAccountLockoutPolicy、DefaultPasswordResetFlow） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Account.Tests" />
  </ItemGroup>

  <!--
    V0.3.0 登录历史与异常检测：Account → SecurityLog 直接引用的门控抑制（TKWF_SG1b_TKWF0022，Error）。

    【架构决策记录——请用户/评审确认，勿复制此模式】
    ADR50 L2 源头禁令要求扩展间耦合走 .Abstractions 依赖倒置；但：
      ① SecurityLog 无 Abstractions 项目（契约接口内嵌于本体，implementation 为 internal）；
      ② 本迭代任务严禁修改 SecurityLog 任何文件（提取 Abstractions 需改 SecurityLog 接口/实现——越界）；
      ③ 消费形态是只读查询契约委托（ILoginHistoryService → ISecurityLogQueryService/AnalyticsService），
         非写路径/非实体引用——符合 D17A "经 Abstractions 调被增强模块服务"的意图，仅缺 Abstractions 载体。
    故按任务裁决（"无 Abstractions 项目则引本体，确认后定"）局部抑制本源禁令。
    正式豁免机制（[TKWFExtensionConsumer] 程序集级特性，ADR50 规划）落地后应替换本 NoWarn；
    或经用户许可后提取 SecurityLog.Abstractions（需修改 SecurityLog，另立迭代）。
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);TKWF_SG1b_TKWF0022</NoWarn>
  </PropertyGroup>

</Project>