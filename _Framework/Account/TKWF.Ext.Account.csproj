<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Account</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Account/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Account</PackageId>
    <Description>TKWF 扩展：账户管理与安全策略（账户锁定 + 密码重置流程默认实现）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />

    <!-- V0.3.0 拆包（用户裁定 B）：账户契约抽象（IAccountPasswordManager）→ Abstractions（ADR48 D7） -->
    <ProjectReference Include="..\Account.Abstractions\TKWF.Ext.Account.Abstractions.csproj" />

    <!-- V0.4.0 依赖倒置（ADR48 D7，L2 门控合规——只引契约不引实现）：登录历史消费 SecurityLog 查询 API
         （SecurityLog 是登录历史唯一数据源，不重复建表）——SecurityLog.Abstractions 契约包（v0.3.0 提取） -->
    <ProjectReference Include="..\SecurityLog.Abstractions\TKWF.Ext.SecurityLog.Abstractions.csproj" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：TKWF.CodeGeneration 纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载，2026-09-15 由 build\refs 预编译 DLL 迁移） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\account.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（FreeSqlAccountLockoutStore、FreeSqlPasswordResetStore、FreeSqlAccountLockoutPolicy、DefaultPasswordResetFlow） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Account.Tests" />
  </ItemGroup>

</Project>
