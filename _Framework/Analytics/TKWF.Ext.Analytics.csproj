<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Analytics</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Analytics/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Analytics</PackageId>
    <Description>TKWF 扩展：分析服务（AnalysisSpec 读取/校验/透传——语义层设计期静态产物对齐 flint ChartAssemblyInput；核心加载校验在 TKWF.Utility.Analytics，本包为 TKWF 集成层门面）</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFw)' == 'true'">
    <!-- 双模式（2026-09-16 方案 B）：UseLocalFw=true（默认）本地联调——ProjectReference 主框架源码。
         4.10.27（含 Utility.Analytics）发布前唯一可用模式；主框架发布后 CI 切 UseLocalFw=false 走 nuget -->
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Utility\TKWF.Utility.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Domain\TKWF.Domain.csproj" />
    <!-- 传递依赖（Utility/Domain 的 ProjectReference 引用不自动带 BCL 包——本地模式需显式补） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFw)' != 'true'">
    <!-- 双模式（2026-09-16 方案 B）：UseLocalFw=false（CI/发布）——PackageReference 主框架 NuGet 包。
         依赖 TKWF.Utility 4.10.27（含 Utility.Analytics）——4.10.27 发布前此模式 restore 失败，
         CI 在 4.10.27 发布前须排除 Analytics（见 ci-publish.yml AnalyticsEnabled 门控） -->
    <PackageReference Include="TKWF.Domain" />
    <PackageReference Include="TKWF.Utility" />
  </ItemGroup>

  <!-- 测试项目访问 internal（如有） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Analytics.Tests" />
  </ItemGroup>

</Project>
