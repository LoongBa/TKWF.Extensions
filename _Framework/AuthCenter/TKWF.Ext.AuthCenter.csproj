<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.AuthCenter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>AuthCenter/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.AuthCenter</PackageId>
    <Description>TKWF 扩展：认证中心——令牌体系（手写 RS256 JWT + kid 轮换 + 黑名单落库 + Refresh rotation）/ 认证矩阵 Provider（短信 + 微信）/ 登录保护 / 票据换令牌（PKCE）/ 身份适配层（JwtDomainUserParser/ITokenVerifier/IAuthorizationMapper/UserHelperBase/中间件）/ 跨系统映射 / 平台凭证</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- v4.10.45（Web 装配钩子）：IWebExtension/MiddlewareAnchor 契约所在程序集——JwtAuthenticationWebExtension 实现 -->
    <PackageReference Include="TKWF.Domain.Web" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Domain.Web" HintPath="$(_LocalFwRefsDir)TKWF.Domain.Web.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.Web.dll')" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载）——恒用 NuGet 包（AGENTS §6 裁定） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

  <!-- V0.2.0：UserCenter 契约承接——引契约包（Abstractions）非主包（L2 门控合规；ADR48 D7；扩展间依赖走 ProjectReference，打包自动转版本依赖） -->
  <ItemGroup>
    <ProjectReference Include="..\UserCenter.Abstractions\TKWF.Ext.UserCenter.Abstractions.csproj" />
  </ItemGroup>

  <!-- V0.6.0（SSO 立项，ADR-SSO Oracle P1-2）：SSO 消费面契约包——接口 + 不可变 DTO（零实体零 SG1）；
       实现类在本主包补实现 ISsoAccountQueryService / ISsoChannelMapService（AuthAccountQueryService / PlatformAccountMapService） -->
  <ItemGroup>
    <ProjectReference Include="..\AuthCenter.Abstractions\TKWF.Ext.AuthCenter.Abstractions.csproj" />
  </ItemGroup>

  <!-- 实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）+ TokenService 黑名单 IMemoryCache 缓存（Oracle C3） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <!-- ⚠️ 身份适配层路径 B 中间件（JwtAuthenticationMiddleware）依赖 ASP.NET Core 类型——
       FrameworkReference Microsoft.AspNetCore.App（net10 共享框架零 NuGet 依赖），对齐 RateLimiting 先例（§四 2b 裁定） -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\authcenter.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.AuthCenter.Tests" />
    <!-- SSO 模块测试（2026-10-05，ADR-SSO）：生产路径测试经 User.Use<AuthAccountEntityDataService>() 种子账号——
         对齐 Notifications.SignalR 先例（主包 IVT 给卫星测试包）——2026-10-05 归层：SSO→Federation -->
    <InternalsVisibleTo Include="TKWF.Ext.Federation.Tests" />
  </ItemGroup>

</Project>
