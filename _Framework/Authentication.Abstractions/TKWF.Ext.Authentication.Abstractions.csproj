<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Authentication</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Authentication.Abstractions/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Authentication.Abstractions</PackageId>
    <Description>TKWF 认证中心契约抽象（SSO 消费面：ISsoAccountQueryService / ISsoChannelMapService + DTO）——依赖倒置（ADR48 D7 / ADR-SSO）：认证中心主包实现契约，SSO 联邦层经契约消费（零实体、零 SG1、不引主包）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-10-05（SSO 立项，ADR-SSO-模块立项与契约归属 Oracle P1-1/P1-2）：契约包只放接口 + 不可变 DTO（record）——
         零实体、零 SG1 分析器（对齐 UserCenter.Abstractions 形态）；但接口继承 IDomainService（User.Use 帧内解析准入）
         需要 TKWF.Domain——非零框架引用（对齐 Permissions.Abstractions 先例，双模式条件化） -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

</Project>
