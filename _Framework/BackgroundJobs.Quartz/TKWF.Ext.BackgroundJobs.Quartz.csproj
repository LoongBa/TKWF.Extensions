<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.BackgroundJobs.Quartz</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>BackgroundJobs.Quartz/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.BackgroundJobs.Quartz</PackageId>
    <Description>TKWF 扩展：Quartz AdoJobStore 一键封装（12 表自动建表 + 集群配置，配置级封装不碰 SQL）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用 + 本块 Reference；false→PackageReference -->
    <PackageReference Include="TKWF.BackgroundJobs.Quartz" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.BackgroundJobs.Quartz" HintPath="$(_LocalFwRefsDir)TKWF.BackgroundJobs.Quartz.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.BackgroundJobs.Quartz.dll')" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <!-- Quartz 4.0.0 单一包（含 Extensions.DependencyInjection/Hosting/序列化——net10.0 ONLY） -->
  <ItemGroup>
    <PackageReference Include="Quartz" />
  </ItemGroup>

  <!-- 测试项目访问 internal -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.BackgroundJobs.Quartz.Tests" />
  </ItemGroup>

</Project>
