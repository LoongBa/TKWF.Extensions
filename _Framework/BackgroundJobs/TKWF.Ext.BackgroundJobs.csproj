<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.BackgroundJobs</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>BackgroundJobs/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.BackgroundJobs</PackageId>
    <Description>TKWF 扩展：后台任务持久化增强——执行历史审计 + 业务结果追踪（IBackgroundJobExecutionListener 自动落库 + IJobResultRecorder 显式记录 + SQL 级聚合查询）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用 + 本块按需 Reference；false→PackageReference -->
    <PackageReference Include="TKWF.BackgroundJobs" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.BackgroundJobs" HintPath="$(_LocalFwRefsDir)TKWF.BackgroundJobs.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.BackgroundJobs.dll')" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />

    <!-- SQL 级聚合扩展（FreeSqlQueryableExtensions——ADR15 聚合 API 分层：DataService 内 AvgAsync/MaxAsync
         经 RestoreToSelect 走 FreeSql ISelect 原生聚合，SQL AVG/MAX 下推，Oracle C1 禁内存 GroupBy） -->
    <PackageReference Include="TKWF.Domain.FreeSql" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Domain.FreeSql" HintPath="$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll')" />

    <!-- SG1 接线（AGENTS.md §8 ①）：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行）（AGENTS.md §8 ②） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖（AGENTS.md §8 ③） -->
  </ItemGroup>

  <!-- FreeSql 特性引用（AGENTS.md §8——实体用 FreeSql [Column]/[Index]） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- SG1 生成文件排除物理编译（避免重复 Decorator 冲突）（AGENTS.md §8 ④） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径（对齐 Tagging 模板） -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\backgroundjobs.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- V4.9.79：单元测试访问 internal 默认实现 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.BackgroundJobs.Tests" />
  </ItemGroup>

</Project>
