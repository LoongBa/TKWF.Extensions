<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.BlobStoring.Abstractions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>BlobStoring.Abstractions/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.BlobStoring.Abstractions</PackageId>
    <Description>TKWF 扩展抽象：二进制存储契约（IBlobStorageService / BlobInfo / BlobStoringOptions）——依赖倒置（ADR50 L2 门控），替代"扩展引扩展"耦合</Description>
  </PropertyGroup>

  <!-- 纯契约项目：IBlobStorageService/BlobInfo/BlobStoringOptions 仅用 BCL（Stream/CancellationToken/Task/string）
       ——零框架引用（对齐 Account.Abstractions 先例） -->

</Project>
