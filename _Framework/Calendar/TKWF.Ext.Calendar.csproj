<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Calendar</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Calendar/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Calendar</PackageId>
    <Description>TKWF 扩展：日历/排程（日历 + 事件 CRUD + UTC 时间范围查询 + 重复规则 DAILY/WEEKLY/MONTHLY/YEARLY occurrence 展开 + FreeSql 持久化）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主框架引用（跨仓库，TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Domain\TKWF.Domain.csproj" />

    <!-- 重复规则算法（RecurrenceRule/RecurrenceExpander）——主框架 Utility（零依赖，ADR-Calendar D2） -->
    <ProjectReference Include="$(TKWFSourceRoot)_Framework\Utility\TKWF.Utility.csproj" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集） -->
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration.Abstractions\TKWF.CodeGeneration.Abstractions.csproj" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行） -->
    <Analyzer Include="$(TKWFSourceRoot)build\refs\TKWF.CodeGeneration.dll" />
    <Analyzer Include="$(TKWFSourceRoot)build\refs\TKWF.CodeGeneration.Abstractions.dll" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration\TKWF.CodeGeneration.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）；SQLite Provider 供测试/本地同步 -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <!-- Microsoft.Data.Sqlite（FreeSql.Provider.Sqlite 传递依赖；Manager 唯一约束异常判定引用 SqliteException） -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径（D1 集中化，gen -j <config>） -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\calendar.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（CalendarStore、DataService、Manager） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Calendar.Tests" />
  </ItemGroup>

</Project>
