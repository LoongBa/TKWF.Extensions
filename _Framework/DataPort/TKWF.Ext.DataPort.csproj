<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.DataPort</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>DataPort/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.DataPort</PackageId>
    <Description>TKWF 扩展：数据导入导出（三层架构——核心运行库 + MiniExcel Provider + 扩展模块带持久化）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用 + 本块按需 Reference；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />

    <!-- DataPort 核心运行库（零依赖） -->
    <PackageReference Include="TKWF.Utility.DataPort" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Utility.DataPort" HintPath="$(_LocalFwRefsDir)TKWF.Utility.DataPort.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Utility.DataPort.dll')" />

    <!-- MiniExcel Provider（可选引入——只读场景可不引用） -->
    <PackageReference Include="TKWF.Utility.DataPort.Providers.MiniExcel" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Utility.DataPort.Providers.MiniExcel" HintPath="$(_LocalFwRefsDir)TKWF.Utility.DataPort.Providers.MiniExcel.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Utility.DataPort.Providers.MiniExcel.dll')" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column] 特性 -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- 测试项目访问 internal -->
  <!-- xCodeGen（D1 集中化）：共享配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\dataport.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.DataPort.Tests" />
  </ItemGroup>

</Project>
