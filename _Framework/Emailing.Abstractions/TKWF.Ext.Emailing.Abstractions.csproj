<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Emailing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Emailing.Abstractions/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Emailing.Abstractions</PackageId>
    <Description>TKWF 扩展抽象：邮件发送契约（IEmailSender / EmailMessage）——依赖倒置（ADR48 D7），替代"扩展引扩展"耦合</Description>
  </PropertyGroup>

  <!-- 纯契约项目：IEmailSender/EmailMessage 仅用 BCL（string/CancellationToken/Task）——零框架引用（对齐 Account.Abstractions 先例） -->

</Project>
