<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Federation.Alipay</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Federation.Alipay/v</MinVerTagPrefix>
    <PackageId>TKWF.Federation.Alipay</PackageId>
    <Description>TKWF 平台网关库（纯库——无 Initializer 无 [TKWFExtension] 无持久化）：支付宝开放平台身份获取网关（出站-only——OAuth 跳转/扫码/H5 授权 auth_code→user_id；RSA2 双向签名）；AlipayApiClient 出站 API 客户端（gateway.do）+ AlipayOptions 配置（TKWF:Federation:Alipay 节）+ AlipayOauthChannel（ISsoChannel alipay_oauth）+ AlipaySignService（签名/验签）【N4 支付宝平台网关库】</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Oracle P1-1（平台网关设计铁律）：库引 Federation 扩展（实现 ISsoChannel——单向依赖无循环；
         扩展不引库。AlipayOauthChannel 实现 ISsoChannel 在此库内） -->
    <ProjectReference Include="..\Federation\TKWF.Ext.Federation.csproj" />
    <!-- 2026-10-09 三层边界（TrustCenter 剥离）：ISsoChannel 契约迁 TrustCenter.Abstractions——平台库直引收口 L2（实现 ISsoChannel 的契约来源） -->
    <ProjectReference Include="..\TrustCenter.Abstractions\TKWF.Ext.TrustCenter.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference
         （ISsoChannel : IDomainService + [Options] 特性所在程序集） -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- RSA2 签名核心：AlipaySignUtil（BuildSignature/VerifyCallbackSignature）+ RsaUtil（SignDataSha256/VerifyDataSha256）
         所在程序集（TKW.Framework.Utility.Cryptography）——双模式：本地 DLL 由 Directory.Build.props 集中引用块承载 -->
    <PackageReference Include="TKWF.Utility" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- DiContractIgnore 所在（TKW.Framework.CodeGeneration——通道运行时手写注册豁免 DI001 误报，对齐 WeChat 先例） -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <!-- HttpClient 注入（IHttpClientFactory——Microsoft.Extensions.Http；Oracle 评审点 5：纯逻辑 + HttpClient，不引 AspNetCore） -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- ⚠️ 不引 AspNetCore（Oracle 评审点 5）：库纯逻辑 + HttpClient（Microsoft.Extensions.Http）；
       入站端点（/sso/oauth/{channelId}/callback）归 Federation 扩展/消费方装配层，库只提供出站逻辑类 -->

  <!-- 测试项目访问 internal（预留，对齐仓库惯例） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Federation.Alipay.Tests" />
  </ItemGroup>

</Project>
