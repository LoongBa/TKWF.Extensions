<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Federation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Federation/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Federation</PackageId>
    <Description>TKWF 扩展：认证中心联邦层（Federation，外交部）——应用注册 / 授权码 accesscode / token2（ES256 独立密钥域 + JWKS）/ profile API / ISsoChannel IdP 适配器契约；组合式消费认证中心（经 Authentication.Abstractions 契约包，零主包传递）；不引主包、零 Store</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-10-05（SSO 立项，ADR-SSO Oracle P1-2/P1-3）：SSO 消费面契约包（接口 + DTO）——
         不引 Authentication 主包（ADR48 D7 L2 门控合规；组合矩阵第三形态零全量传递） -->
    <ProjectReference Include="..\AuthCenter.Abstractions\TKWF.Ext.AuthCenter.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <!-- SG1 分析器：纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载）——恒用 NuGet 包（AGENTS §6 裁定） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
    <!-- 实体使用 FreeSql [Column] 特性 -->
    <PackageReference Include="FreeSql" />
    <!-- token2 黑名单/缓存（对齐 Authentication Oracle C3 前置过滤） -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <!-- ⚠️ JWKS/profile/端点装配依赖 ASP.NET Core 类型——FrameworkReference Microsoft.AspNetCore.App（net10 共享框架零 NuGet），
       对齐 Authentication/RateLimiting 先例 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\federation.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Federation.Tests" />
  </ItemGroup>

</Project>
