<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.FileManagement</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>FileManagement/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.FileManagement</PackageId>
    <Description>TKWF 扩展：文件管理（目录树 FileFolder 物化路径 + 文件元数据 ManagedFile SHA256/去重 + 安全校验链上传/下载/删除/重命名/移动门面；物理存储委托 BlobStoring.Abstractions）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式引用（2026-09-16 用户裁定，DLL 模式定案）：
         UseLocalFw=true（本地，默认）→ 集中 DLL 引用（Directory.Build.props _LocalFwRefsDir）+ 本块按需 Reference；
         UseLocalFw=false（CI/发布）→ PackageReference 主框架 NuGet 包（CPM 集中版本）。 -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />

    <!-- V0.2.0 配额 SQL 聚合下推：TKWF.Domain.FreeSql（FreeSqlQueryableExtensions.SumAsync——SQL SUM，
         对齐 BackgroundJobs GetStatsAsync 先例；ADR15 聚合分层） -->
    <PackageReference Include="TKWF.Domain.FreeSql" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Domain.FreeSql" HintPath="$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll')" />

    <!-- 扩展间契约（C1/ADR50 L2 门控）：只引 BlobStoring.Abstractions（IBlobStorageService/BlobInfo/BlobStoringOptions），
         不引 BlobStoring 实现项目——依赖倒置，物理存储经契约委托 -->
    <ProjectReference Include="..\BlobStoring.Abstractions\TKWF.Ext.BlobStoring.Abstractions.csproj" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）；SQLite Provider 供测试/本地同步 -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <!-- Microsoft.Data.Sqlite（FreeSql.Provider.Sqlite 传递依赖；Manager 唯一约束异常判定引用 SqliteException） -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径（D1 集中化，gen -j <config>） -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\filemanagement.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（FileFolderStore、ManagedFileStore、DataService、FileManagementMimeMap） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.FileManagement.Tests" />
  </ItemGroup>

</Project>
