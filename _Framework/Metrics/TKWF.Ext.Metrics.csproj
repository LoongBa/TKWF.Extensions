<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Metrics</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Metrics/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Metrics</PackageId>
    <Description>TKWF 扩展：业务指标计算引擎（规格文档驱动的复合业务指标计算；核心计算在 TKWF.Utility.Metrics，本包为 TKWF 集成层）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props 含 Utility）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- 核心计算：TKW.Framework.Utility.Metrics（零第三方依赖，无 SG1/FreeSql 接线——本扩展无持久化实体，对齐 Tagging 瘦身模式） -->
    <PackageReference Include="TKWF.Utility" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <!-- 测试项目访问 internal（如有） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Metrics.Tests" />
  </ItemGroup>

</Project>
