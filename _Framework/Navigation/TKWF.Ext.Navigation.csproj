<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Navigation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Navigation/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Navigation</PackageId>
    <Description>TKWF 扩展：菜单数据模型与贡献机制（MenuItemDefinition + IMenuContributor + IMenuManager 权限过滤）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- SG1 契约（[TKWFExtension] 特性 + MenuContributorData——NavigationExtensionInitializer 引用 TKW.Framework.CodeGeneration 命名空间）：
         DLL 模式下 Domain 直接引用不传递 NuGet 依赖，须显式补 CodeGeneration.Abstractions -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <!-- V4.9.85 (ADR48 D7)：Navigation 引用 Permissions.Abstractions（依赖倒置），不引用 Permissions 实现项目 -->
    <ProjectReference Include="..\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />
    <!-- V4.10.30 (A+ 阶段 2)：契约归位 Navigation.Abstractions（IMenuContributor/MenuItemDefinition/MenuConfigurationContext 迁入） -->
    <ProjectReference Include="..\Navigation.Abstractions\TKWF.Ext.Navigation.Abstractions.csproj" />
  </ItemGroup>

  <!-- V4.9.74 (W6): 单元测试访问 internal 默认实现（MenuDefinitionRepository/MenuManager） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Navigation.Tests" />
  </ItemGroup>

</Project>