<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Permissions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TKWF.Ext.Permissions</PackageId>
    <Description>TKWF 扩展：细粒度权限管理（PermissionDefinition + IPermissionChecker + RequirePermission）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主框架引用（跨仓库，TKWFRoot 定义于 ../Directory.Build.props，对齐 DMP-Lite 模式） -->
    <ProjectReference Include="$(TKWFRoot)_Framework\Domain\TKWF.Domain.csproj" />

    <!-- V4.9.85 (ADR48 D7)：抽象项目引用（依赖倒置——接口/契约在 Abstractions，实现在本项目） -->
    <ProjectReference Include="..\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />

    <!-- V0.2.0 (SG1 化)：框架抽象引用（[DomainGenerateCode] 属性所在程序集） -->
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\CodeGeneration.Abstractions\TKWF.CodeGeneration.Abstractions.csproj" />

    <!-- V0.2.0 (SG1 化)：SG1 分析器用预编译 DLL（build\refs，DMP-Lite 验证稳定执行；
         不用 ProjectReference+OutputItemType="Analyzer"——Roslyn 增量缓存可能导致生成器不执行） -->
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.CodeGeneration.dll" />
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.CodeGeneration.Abstractions.dll" />

    <!-- V0.2.0 (SG1 化)：VS FastUpToDateCheck——让 VS 识别 SG 依赖（ReferenceOutputAssembly=false 不产生运行时引用） -->
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\CodeGeneration\TKWF.CodeGeneration.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）。
       直接引用 FreeSql NuGet 包（不能 ProjectReference TKWF.Domain.FreeSql——它与本扩展互相引用形成循环依赖） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：xCodeGen（可选，仅 Debug 触发）：定义配置路径走 D1 集中化 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\.xCodeGen\permissions.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- V4.9.72 (W6): 单元测试访问 internal 默认实现（InMemoryPermissionDefinitionRepository/PermissionChecker/NoOpPermissionStore） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Permissions.Tests" />
    <!-- V0.7.0 (W4): 消费方集成验证测试访问 internal 默认实现（端到端权限检查） -->
    <InternalsVisibleTo Include="TKWF.Ext.Permissions.Consumer.Tests" />
  </ItemGroup>

  <!-- V0.7.0 (W2): 生产建表迁移脚本随 NuGet 打包（scripts\PermissionGrant.sql），
       消费方/DBA 从包内 scripts\ 目录取用执行 -->
  <ItemGroup>
    <None Include="scripts\PermissionGrant.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>

  <!-- V0.4.0 (G2): 扩展为预编译库——DataService 标记 [GenerateController] 但自身无具体 TUser，
       控制器由消费方 SG1b 经 ReferencedAssemblySymbols 发现生成（ControllerGenerator L1002 设计）。
       以下 SG1b 诊断是预期：CTRL003（无 TUser 本地推断失败）+ CTRL006（业务 Service 建议 internal——
       但扩展 DataService 必须 public 供消费方生成代码跨程序集引用，同框架内置类型豁免原则 L894-897）。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);TKWF_SG1b_CTRL003;TKWF_SG1b_CTRL006</NoWarn>
  </PropertyGroup>

</Project>
