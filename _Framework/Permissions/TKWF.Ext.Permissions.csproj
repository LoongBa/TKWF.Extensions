<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Permissions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Permissions/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Permissions</PackageId>
    <Description>TKWF 扩展：细粒度权限管理（PermissionDefinition + IPermissionChecker + RequirePermission）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式引用（2026-09-16 用户裁定，DLL 模式定案）：
         UseLocalFw=true（本地，默认）→ 集中 DLL 引用（Directory.Build.props _LocalFwRefsDir 部署根 build/refs）
            + 本块按需 Reference（CodeGeneration.Abstractions——SG 元数据类型所在）；
         UseLocalFw=false（CI/发布）→ PackageReference 主框架 NuGet 包（CPM 集中版本，2026-09-15 语义）。
         Domain/Core/Utility/Abstractions 由集中块承载（Directory.Build.props）——本块仅补按需项。 -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：TKWF.CodeGeneration 为纯 Analyzer 包（analyzers/dotnet/cs/，无 lib/），
         Roslyn 自动加载，无需 <Analyzer> 元素（勿用 OutputItemType="Analyzer"——G17A 已验证增量缓存bug）。
         原表格：<Analyzer Include="$(TKWFSourceRoot)build\refs\..."> 两条 → 一条 PackageReference 替代。
         VS FastUpToDateCheck 引用（ReferenceOutputAssembly=false 的 CodeGeneration.csproj）删除——
         PackageReference 天然被 VS 识别，无需 FUTC 桥。 -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- 依赖倒置（ADR48 D7）：抽象项目引用（接口/契约在 Abstractions，实现在本项目） -->
    <ProjectReference Include="..\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）。
       直接引用 FreeSql NuGet 包（不能 ProjectReference TKWF.Domain.FreeSql——它与本扩展互相引用形成循环依赖） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- V0.2.0 (SG1 化)：xCodeGen（可选，仅 Debug 触发）：定义配置路径走 D1 集中化 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\permissions.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- V4.9.72 (W6): 单元测试访问 internal 默认实现（InMemoryPermissionDefinitionRepository/PermissionChecker/NoOpPermissionStore） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Permissions.Tests" />
    <!-- V0.7.0 (W4): 消费方集成验证测试访问 internal 默认实现（端到端权限检查） -->
    <InternalsVisibleTo Include="TKWF.Ext.Permissions.Consumer.Tests" />
  </ItemGroup>

  <!-- V0.7.0 (W2): 生产建表迁移脚本随 NuGet 打包（scripts\PermissionGrant.sql），
       消费方/DBA 从包内 scripts\ 目录取用执行 -->
  <ItemGroup>
    <None Include="scripts\PermissionGrant.sql" Pack="true" PackagePath="scripts\" />
  </ItemGroup>

  <!-- V0.4.0 (G2): 扩展为预编译库——DataService 标记 [GenerateController] 但自身无具体 TUser，
       控制器由消费方 SG1b 经 ReferencedAssemblySymbols 发现生成（ControllerGenerator L1002 设计）。
       以下 SG1b 诊断是预期：CTRL003（无 TUser 本地推断失败）+ CTRL006（业务 Service 建议 internal——
       但扩展 DataService 必须 public 供消费方生成代码跨程序集引用，同框架内置类型豁免原则 L894-897）。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);TKWF_SG1b_CTRL003;TKWF_SG1b_CTRL006</NoWarn>
  </PropertyGroup>

</Project>
