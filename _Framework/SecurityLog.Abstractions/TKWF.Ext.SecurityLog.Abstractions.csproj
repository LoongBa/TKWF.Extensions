<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.SecurityLog</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>SecurityLog.Abstractions/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.SecurityLog.Abstractions</PackageId>
    <Description>TKWF 扩展抽象：安全日志契约（ISecurityLogStore/ISecurityLogQueryService/ISecurityLogAnalyticsService + DTO/Options）——依赖倒置（ADR48 D7），替代"扩展引扩展"耦合</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-09-30 提取（ADR48 D7）：SecurityLoggingOptions 依赖 [Options("TKWF:SecurityLog")]（TKW.Framework.Domain）——需引 TKWF.Domain
          2026-09-16 双模式 DLL 定案：UseLocalFw=true→集中 DLL 引用；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

</Project>
