<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.SmsCode</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>SmsCode/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.SmsCode</PackageId>
    <Description>TKWF 扩展：短信验证码引擎（手机号持有权验证）——发送/校验/频控/落库/场景注册表/CAPTCHA 门禁内联（M3）——Subject 不透明键控 + 单次消费 CAS + FixedTimeEquals 比对</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Domain" HintPath="$(_LocalFwRefsDir)TKWF.Domain.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.dll')" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载）——恒用 NuGet 包（AGENTS §6 裁定） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

  <!-- M3（门禁内联 Q6）：Captcha.Abstractions 契约包可空依赖（场景要求门禁但 Captcha 未装配 → 守卫异常 fail-closed，
       禁静默跳过——m7 评审闭环）；依赖倒置（ADR48 D7）：只引契约包不引 Captcha 主包（TKWF0022 L2 门控） -->
  <ItemGroup>
    <ProjectReference Include="..\Captcha.Abstractions\TKWF.Ext.Captcha.Abstractions.csproj" />
  </ItemGroup>

  <!-- 实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations）；IRateLimitCheck fallback → MemoryRateLimitCheck（框架 v4.10.67） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <!-- IP 获取：IHttpContextAccessor 经 FrameworkReference Microsoft.AspNetCore.App（net10 共享框架零 NuGet 依赖），对齐 AuthCenter 先例 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\smscode.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（引擎/实现类） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.SmsCode.Tests" />
  </ItemGroup>

</Project>