<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.Tagging</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>Tagging/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.Tagging</PackageId>
    <Description>TKWF 扩展：标签存储扩展（标签算法来自 TKWF.Utility.Tags，ADR52；规则/命中持久化 + 聚合分析 V0.3.0）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props 含 Utility）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- ADR52：标签算法引擎在运行时工具库 TKWF.Utility（TKW.Framework.Utility.Tags） -->
    <PackageReference Include="TKWF.Utility" Condition="'$(UseLocalFw)' != 'true'" />

    <!-- SG1 化（V0.3.0 接线）：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：用预编译 DLL（build\refs，稳定执行） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
  </ItemGroup>

  <!-- SG1 化：实体使用 FreeSql [Column]/[Index] 特性（FreeSql.DataAnnotations，Oracle P1-5） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径（Oracle P1-5：对齐 DataDictionary 模板） -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\tagging.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- V4.9.79：单元测试访问 internal 默认实现 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.Tagging.Tests" />
  </ItemGroup>

</Project>
