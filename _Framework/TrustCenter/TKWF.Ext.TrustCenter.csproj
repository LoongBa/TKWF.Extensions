<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.TrustCenter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>TrustCenter/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.TrustCenter</PackageId>
    <Description>TKWF 扩展：信任中心（TrustCenter，纯信任内核——2026-10-09 自 Federation 剥离）——应用注册（SsoClientEntity）/ token2（ES256 独立密钥域 + JWKS）/ accesscode（授权码）+ ISsoChannel 契约（Abstractions）；内网中枢零外部协议依赖（Federation 对外连接层经契约消费）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-10-09（TrustCenter 剥离，T1/T2）：信任内核契约包（ISsoChannel/IToken2Service/IAccessCodeService——接口 + DTO） -->
    <ProjectReference Include="..\TrustCenter.Abstractions\TKWF.Ext.TrustCenter.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <!-- SG1 分析器：纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载）——恒用 NuGet 包（AGENTS §6 裁定） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
    <!-- 实体使用 FreeSql [Column] 特性 -->
    <PackageReference Include="FreeSql" />
    <!-- token2 黑名单/缓存（对齐 Authentication Oracle C3 前置过滤） -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <!-- ⚠️ JWKS/profile/端点装配依赖 ASP.NET Core 类型——FrameworkReference Microsoft.AspNetCore.App（net10 共享框架零 NuGet），
       对齐 Authentication/RateLimiting 先例（JWKS 端点装配保留） -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\trustcenter.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.TrustCenter.Tests" />
  </ItemGroup>

</Project>
