<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.UserCenter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>UserCenter/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.UserCenter</PackageId>
    <Description>TKWF 用户中心扩展（档案面内核）——公共 Profile API + 兑换历史/我的应用经扩展间契约协作；领域逻辑（脱敏/降级/聚合）进扩展，数据源由认证中心/授权面/装配实例实现契约</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约包（编译期确定，打包时自动转版本依赖）——扩展内依赖走 ProjectReference（AGENTS §6） -->
    <ProjectReference Include="..\UserCenter.Abstractions\TKWF.Ext.UserCenter.Abstractions.csproj" />
  </ItemGroup>

  <!-- 测试项目访问 internal（如有） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.UserCenter.Tests" />
  </ItemGroup>

</Project>