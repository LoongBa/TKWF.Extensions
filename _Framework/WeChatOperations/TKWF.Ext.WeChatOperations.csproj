<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
    <Platforms>AnyCPU;x64</Platforms>
    <NoWarn>$(NoWarn);TKWF_SG1b_TKWF0022;TKWF_SG1b_TKWF0030</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TKWF.Ext.WeChatOperations</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>WeChatOperations/v</MinVerTagPrefix>
    <PackageId>TKWF.Ext.WeChatOperations</PackageId>
    <Description>TKWF 扩展：微信公众号运营（公众号渠道配置/素材/回复规则/菜单/订阅统计/交互日志——数据底座，通讯走平台库 Federation.WeChat）</Description>
    <!-- 骨架阶段（实体型，尚无 Initializer——门面任务补）：Federation.WeChat 平台库自身 ProjectReference 了 TKWF.Ext.Federation
         （扩展实现程序集），若允许其传递引用流入本编译将触发 L1 普通项目门控（TKWF0030——非领域非扩展项目直引扩展）。
         本阶段实体零 Federation 类型消费，切断传递引用只让平台库程序集流入编译；门面任务接入 Federation 契约类型时
         再按 L2 依赖倒置收口（Abstractions 契约包）显式声明需求引用（设计文档 §3.3.4 接入点 ② 实施核查）。 -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- 平台网关库（库引——通讯走平台库，单向依赖无循环；设计文档 §3.3.4：DbWeChatCredentialResolver/DbWeChatChannelSource
         消费 Federation.WeChat 出站/验签/事件回复逻辑，此处仅声明库引用，凭证/事件能力由后续门面任务装配） -->
    <ProjectReference Include="..\Federation.WeChat\TKWF.Federation.WeChat.csproj" />
    <!-- 网关运行库（纯逻辑零实体零持久化——V0.2.0 增网关模块：路由规则判定/幂等键规范化/转发决策与降级链/熔断状态机；
         MessageGatewayService.RouteAsync 经其静态类型组合，非 DI 服务直用——方案 §十·〇 ①） -->
    <ProjectReference Include="..\Federation.WeChat.MessageGateway\TKWF.Federation.WeChat.MessageGateway.csproj" />
    <!-- L2 门控核查（门面任务，设计文档 §3.3.4 接入点 ②）：Federation 主包契约（ChannelConfig/IChannelSource/
         IChannelRegistry/IEventReplyHandler）无 Abstractions 契约包收口（Federation 无独立 Abstractions 项目）——
         显式需求引用 Federation 主包。⚠️ L2 源头禁令 TKWF0022 判据 = 引用含 ExtensionInitializer<T> 的程序集；
         本扩展虽为扩展项目但需 Federation 契约类型（ChannelConfig 投影 / IChannelSource 注册 / IEventReplyHandler
         集合注册 / CompositeChannelRegistry 组合语义）——Federation.WeChat 平台库自身 ProjectReference Federation
         （分析器出口仅拦"扩展项目直引扩展实现"，平台库先例 Oracle P1-1 单向依赖合法，库引扩展为同型先例；
         本扩展契约引用面与平台库一致，显式声明注释声明依据）。生产包依赖由 CPM/NuGet 拓扑决定，不经源码引用点火。 -->
    <ProjectReference Include="..\Federation\TKWF.Ext.Federation.csproj" />
<!-- 信任契约包（TrustCenter.Abstractions——WechatEventReplyHandlerBase/EventReplyNewsArticle/SsoChannelEventContext
         等事件回复信封类型所在；平台库 Federation.WeChat 经其实现 ISsoChannel，本扩展 handler 消费事件信封闭包类型） -->
    <ProjectReference Include="..\TrustCenter.Abstractions\TKWF.Ext.TrustCenter.Abstractions.csproj" />
    <!-- 权限契约包（Permisisions.Abstractions——[RequirePermission] 门面权限标注；设计文档 §3.3.5 Oracle P1，
         只读查询 WeChatOperations.Query / 写操作 WeChatOperations.Manage） -->
    <ProjectReference Include="..\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 双模式（2026-09-16 DLL 模式定案）：UseLocalFw=true→集中 DLL 引用（Directory.Build.props）；false→PackageReference -->
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain.Web" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Domain.Web" HintPath="$(_LocalFwRefsDir)TKWF.Domain.Web.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.Web.dll')" />

    <!-- SG1 化：框架抽象引用（[DomainGenerateCode] 属性所在程序集）——双模式条件化 -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />

    <!-- SG1 分析器：纯 Analyzer 包（analyzers/dotnet/cs/，Roslyn 自动加载）——恒用 NuGet 包（AGENTS §6 版本锁；本地 feed 测试机制见 §6 方案 B） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

<!-- SG1 化：实体使用 FreeSql [Column] 特性（FreeSql.DataAnnotations） -->
  <ItemGroup>
    <PackageReference Include="FreeSql" />
  </ItemGroup>

  <!-- Web 端点（WeChatOperationsWebExtension——手写 minimal API + FrameworkReference 共享框架零 NuGet） -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- SG1 化：xCodeGen 配置路径 -->
  <PropertyGroup>
    <_XCG_ConfigPath>$(MSBuildProjectDirectory)\..\..\.xCodeGen\extensions\wechatoperations.xCodeGen.json</_XCG_ConfigPath>
  </PropertyGroup>

  <!-- 测试项目访问 internal（门面任务后建 Extension.WeChatOperations.Tests） -->
  <ItemGroup>
    <InternalsVisibleTo Include="TKWF.Ext.WeChatOperations.Tests" />
  </ItemGroup>

</Project>
