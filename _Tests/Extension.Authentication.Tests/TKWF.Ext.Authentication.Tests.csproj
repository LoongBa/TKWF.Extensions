<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.Authentication.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <!-- 中间件测试（路径 B：Bearer JWT → DomainUser 恢复 + HttpAuthenticationMiddleware 标记） -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FreeSql" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
    <Using Include="TKW.Framework.Domain.Hosting" />
    <Using Include="TKW.Framework.Core.Hosting" />
    <Using Include="TKW.Framework.Domain.Session" />
    <Using Include="TKW.Framework.Enumerations" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本仓库扩展（Authentication）+ 主框架（TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="..\..\_Framework\Authentication\TKWF.Ext.Authentication.csproj" />
    <!-- v0.2.0：UserCenter 契约承接测试（N2-N5——UserCenterQueryService 门面 + IUserProfileSource 契约） -->
    <ProjectReference Include="..\..\_Framework\UserCenter\TKWF.Ext.UserCenter.csproj" />
    <ProjectReference Include="..\..\_Framework\UserCenter.Abstractions\TKWF.Ext.UserCenter.Abstractions.csproj" />
    <PackageReference Include="TKWF.Core" />
    <PackageReference Include="TKWF.Domain" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" />
    <PackageReference Include="TKWF.Domain.FreeSql" />
  </ItemGroup>

</Project>
