<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.DataPort.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
    <Using Include="TKW.Framework.Domain.Hosting" />
    <Using Include="TKW.Framework.Core.Hosting" />
    <Using Include="TKW.Framework.Domain.Session" />
    <Using Include="TKW.Framework.Enumerations" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本仓库扩展（DataPort）+ 主框架（TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="..\..\_Framework\DataPort\TKWF.Ext.DataPort.csproj" />
    <PackageReference Include="TKWF.Core" />
    <PackageReference Include="TKWF.Domain" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" />
    <PackageReference Include="TKWF.Domain.FreeSql" />
    <!-- 双模式：DLL 模式（UseLocalFw=true）下 ProjectReference 不传递 Utility.DataPort——测试引 ImportRow 等核心类型须显式补 -->
    <PackageReference Include="TKWF.Utility.DataPort" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Utility.DataPort" HintPath="$(_LocalFwRefsDir)TKWF.Utility.DataPort.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Utility.DataPort.dll')" />
    <!-- MiniExcel Provider（测试用 MiniExcelProvider/MiniExcelLibs——双模式条件化） -->
    <PackageReference Include="TKWF.Utility.DataPort.Providers.MiniExcel" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.Utility.DataPort.Providers.MiniExcel" HintPath="$(_LocalFwRefsDir)TKWF.Utility.DataPort.Providers.MiniExcel.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Utility.DataPort.Providers.MiniExcel.dll')" />
    <!-- MiniExcelLibs（MiniExcel 第三方引擎——DLL 模式下 Provider dll 的 NuGet 传递依赖不生效，须显式） -->
    <PackageReference Include="MiniExcel" />
  </ItemGroup>

</Project>