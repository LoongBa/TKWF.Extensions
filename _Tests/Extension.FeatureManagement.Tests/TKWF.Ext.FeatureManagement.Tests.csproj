<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.FeatureManagement.Tests</RootNamespace>
    <!-- V4.10.31 (A+ 阶段 3)：显式钉 UseLocalFw=true（DLL 模式）——不设时 NuGet 4.10.27 旧包覆盖部署根 DLL，
         运行时 TypeLoadException（ContributorDescriptor 不存在）实证 -->
    <UseLocalFw>true</UseLocalFw>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <!-- V4.10.31 (A+ 阶段 3)：DLL 模式补 FreeSql.DbContext——UnitOfWorkManager 所在程序集；
         NuGet 模式经 FreeSql 包传递提供，DLL 模式（TKWF.Domain.FreeSql Reference 不传递 NuGet）需显式 -->
    <PackageReference Include="FreeSql.DbContext" />
    <!-- V4.10.31 (A+ 阶段 3)：DLL 模式补 FreeSql.Extensions.Linq——DAC 查询扩展传递失效（FileNotFound 实证） -->
    <PackageReference Include="FreeSql.Extensions.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
    <Using Include="TKW.Framework.Domain.Hosting" />
    <Using Include="TKW.Framework.Core.Hosting" />
    <Using Include="TKW.Framework.Domain.Session" />
    <Using Include="TKW.Framework.Enumerations" />
    <!-- FeatureChecker<TUserInfo> 实现 TKW.Framework.Core.Features.IFeatureChecker（框架接口） -->
    <Using Include="TKW.Framework.Core.Features" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本仓库扩展（FeatureManagement）+ 主框架（TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="..\..\_Framework\FeatureManagement\TKWF.Ext.FeatureManagement.csproj" />
    <!-- V4.10.31 (A+ 阶段 3)：DLL 模式（UseLocalFw=true）主框架包走 Directory.Build.props 集中 DLL 块 +
         显式 Reference CodeGeneration.Abstractions（部署根含 ContributorDescriptor/Contributors 桥）——
         避免 NuGet 4.10.27 旧包覆盖（TypeLoadException 实证）；NuGet 模式（false）走 CPM 包 -->
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <!-- V4.10.31 (A+ 阶段 3)：DLL 模式 Domain.FreeSql 需显式 Reference（Directory.Build.props 集中块不含——L70 注释"Domain.FreeSql 各 csproj 自引"） -->
    <Reference Include="TKWF.Domain.FreeSql" HintPath="$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll')" />
    <PackageReference Include="TKWF.Domain.FreeSql" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

</Project>
