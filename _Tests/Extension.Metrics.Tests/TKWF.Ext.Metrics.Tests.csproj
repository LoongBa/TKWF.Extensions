<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.Metrics.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- T0（v0.2.0）：测试宿主内定义 [DomainGenerateCode] 实体（模拟消费方）——FreeSql 包接线 -->
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Utility.Metrics" />
    <Using Include="TKW.Framework.Utility.Metrics.Calculators" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
    <Using Include="TKW.Framework.Domain.Hosting" />
    <Using Include="TKW.Framework.Core.Hosting" />
    <Using Include="TKW.Framework.Domain.Session" />
    <Using Include="TKW.Framework.Enumerations" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本仓库扩展（Metrics）+ 主框架（TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="..\..\_Framework\Metrics\TKWF.Ext.Metrics.csproj" />
    <PackageReference Include="TKWF.Core" />
    <PackageReference Include="TKWF.Domain" />
    <!-- T0（v0.2.0）：FreeSql DAC 接线（消费方模拟——测试内定义实体 + 真实 FreeSqlEntityDAC 驱动） -->
    <PackageReference Include="TKWF.Domain.FreeSql" />
    <!-- T0（v0.2.0）：SG1 化——框架抽象引用（[DomainGenerateCode] 属性所在程序集，保留既有） -->
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" />

    <!-- T0（v0.2.0）：SG1 分析器（build/refs 预编译 DLL，测试宿主首次定义 [DomainGenerateCode] 实体——
         若生成器不识别测试项目，按方案 §四 T0 替代路径改手写 DataService 分部子类，详见 TestMetricResultEntity 注释） -->
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />

    <!-- VS FastUpToDateCheck：让 VS 识别 SG 依赖 -->
  </ItemGroup>

  <!-- SG1 化：SG1 生成文件排除物理编译（避免重复 Decorator 冲突，对齐扩展 csproj） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

</Project>
