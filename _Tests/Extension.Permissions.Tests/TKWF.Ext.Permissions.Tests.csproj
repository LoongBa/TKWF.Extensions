<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.Permissions.Tests</RootNamespace>
    <!-- V4.10.31 (A+ 阶段 3)：显式钉 UseLocalFw=true（DLL 模式）——不设时 NuGet 4.10.27 旧包覆盖部署根 DLL，
         运行时 TypeLoadException（ContributorDescriptor 不存在，阶段 1 才加）实证 -->
    <UseLocalFw Condition="'$(UseLocalFw)' == ''">true</UseLocalFw>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本仓库扩展（Permissions）+ 主框架（TKWFSourceRoot 定义于 ../Directory.Build.props） -->
    <ProjectReference Include="..\..\_Framework\Permissions\TKWF.Ext.Permissions.csproj" />
    <!-- V4.10.31 (A+ 阶段 3)：DLL 模式（UseLocalFw=true）主框架包走 Directory.Build.props 集中 DLL 块 +
         显式 Reference CodeGeneration.Abstractions（部署根含 ContributorDescriptor/Contributors 桥）——
         避免 NuGet 4.10.27 旧包覆盖（TypeLoadException 实证）；NuGet 模式（false）走 CPM 包 -->
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

</Project>