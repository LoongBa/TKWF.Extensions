<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.RateLimiting.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- TestServer（HTTP 级限流验证）。VersionOverride：CPM 未收录 ASP.NET Core 测试包——按 CSP 规则
         本条目显式覆盖版本（对齐 Microsoft.Extensions 10.0.11），不改 Directory.Packages.props（no CPM 接线） -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost"  />
    <!-- SqlCountRateLimitCheck 测试（v0.3.0）：FreeSql SQLite 内存/文件库 + 真实 FreeSqlEntityDAC 驱动 -->
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Extensions.Linq" />
    <PackageReference Include="FreeSql.DbContext" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
    <Using Include="TKW.Framework.Domain.Hosting" />
    <Using Include="TKW.Framework.Core.Hosting" />
    <Using Include="TKW.Framework.Domain.Session" />
    <Using Include="TKW.Framework.Enumerations" />
  </ItemGroup>

  <ItemGroup>
    <!-- C 基座共享（2026-10-04）：去重复样板——TestUserInfo/TestMetaContext/TestUserHelper 公共类 -->
    <ProjectReference Include="..\Extension.Testing.Shared\TKWF.Ext.Testing.Shared.csproj" />
    <!-- 本仓库扩展 + 主框架（HTTP 级测试需 ASP.NET Core 共享框架） -->
    <ProjectReference Include="..\..\_Framework\RateLimiting\TKWF.Ext.RateLimiting.csproj" />
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Utility" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
  <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <!-- FreeSqlEntityDAC + UnitOfWorkManager：测试经真实 FreeSql DAC 驱动 DataService（红线合规委托路径） -->
    <Reference Include="TKWF.Domain.FreeSql" HintPath="$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Domain.FreeSql.dll')" />
    <PackageReference Include="TKWF.Domain.FreeSql" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
