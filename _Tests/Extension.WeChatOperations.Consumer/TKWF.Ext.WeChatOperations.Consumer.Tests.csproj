<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.WeChatOperations.Consumer.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- V0.10.0（WARN009 契约形状纠正）P11 载体：默认 DLL 模式（消费方 DLL 引用形态复现——
         扩展经 raw Reference（非传递）引用，编译引用集【不含】TKWF.Federation.WeChat.MessageGateway.dll
         （复现 DMP WebApi 漏列形态）；NuGet 模式（CI/UseLocalFw=false）走 ProjectReference 保证可编译——
         code-reviewer P0 #1 闭环：双模式必可构建 -->
    <UseLocalFw Condition="'$(UseLocalFw)' == ''">true</UseLocalFw>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测扩展——DLL 引用（raw Reference 非传递，对齐 DMP WebApi.csproj L92-101 形态）：
         WeChatChannels 双包（通道底座依赖）+ WeChatOperations 主包 + Federation.Abstractions（关注域契约）
         + Federation.WeChat（平台库——接口签名暴露其类型时需显式）+ 【故意的】缺 MessageGateway.dll -->
    <Reference Include="TKWF.Ext.WeChatChannels.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.Ext.WeChatChannels.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Ext.WeChatChannels.Abstractions.dll')" />
    <Reference Include="TKWF.Ext.WeChatChannels" HintPath="$(_LocalFwRefsDir)TKWF.Ext.WeChatChannels.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Ext.WeChatChannels.dll')" />
    <Reference Include="TKWF.Ext.Permissions.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.Ext.Permissions.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Ext.Permissions.Abstractions.dll')" />
    <Reference Include="TKWF.Ext.WeChatOperations" HintPath="$(_LocalFwRefsDir)TKWF.Ext.WeChatOperations.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Ext.WeChatOperations.dll')" />
    <Reference Include="TKWF.Federation.WeChat" HintPath="$(_LocalFwRefsDir)TKWF.Federation.WeChat.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Federation.WeChat.dll')" />
    <Reference Include="TKWF.Federation.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.Federation.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Federation.Abstractions.dll')" />
    <!-- DLL 模式 raw Reference 不传递：FeatureManagement（WeChatOperations 依赖扩展——消息业务总开关 DB 化，白名单所需）显式补 -->
    <Reference Include="TKWF.Ext.FeatureManagement" HintPath="$(_LocalFwRefsDir)TKWF.Ext.FeatureManagement.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.Ext.FeatureManagement.dll')" />
    <!-- ⚠️ 无 TKWF.Federation.WeChat.MessageGateway.dll——DMP 漏列形态复现（P11 载体核心） -->
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
  </ItemGroup>

  <!-- NuGet 模式（UseLocalFw=false，CI 全量 slnx 构建）——扩展走 ProjectReference 保证可编译
       （code-reviewer P0 #1 闭环；Permissions.Consumer 同型先例；DLL 模式仍走上方 raw Reference 复现形态） -->
  <ItemGroup Condition="'$(UseLocalFw)' != 'true'">
    <ProjectReference Include="..\..\_Framework\WeChatChannels.Abstractions\TKWF.Ext.WeChatChannels.Abstractions.csproj" />
    <ProjectReference Include="..\..\_Framework\WeChatChannels\TKWF.Ext.WeChatChannels.csproj" />
    <ProjectReference Include="..\..\_Framework\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />
    <ProjectReference Include="..\..\_Framework\WeChatOperations\TKWF.Ext.WeChatOperations.csproj" />
    <ProjectReference Include="..\..\_Framework\Federation.WeChat\TKWF.Federation.WeChat.csproj" />
    <ProjectReference Include="..\..\_Framework\Federation.Abstractions\TKWF.Federation.Abstractions.csproj" />
  </ItemGroup>

  <!-- V0.10.0：激活 SG1 分析器（纯 Analyzer 包）——SG1b 在消费方生成
       GeneratedControllerRegistrations（catalog/InterfaceNames），SG2a 同链路诊断 -->
  <ItemGroup>
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

  <!-- SG1 生成文件排除物理编译（对齐扩展 csproj 惯例） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- 消费方引用扩展 DLL：SG1b 在消费方推断 TUser 后生成控制器——
       CTRL006（业务 Service 建议 internal）/CTRL003 在消费方属预期（对齐 Permissions.Consumer 先例） -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);TKWF_SG1b_CTRL003;TKWF_SG1b_CTRL006;TKWF_SG1a_WRN_001;CS0436</NoWarn>
  </PropertyGroup>

</Project>