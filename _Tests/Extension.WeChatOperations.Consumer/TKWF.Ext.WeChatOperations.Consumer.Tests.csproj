<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TKWF.Ext.WeChatOperations.Consumer.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- V0.10.0（WARN009 契约形状纠正）P11 载体：默认 DLL 模式（UseLocalFw=true 主框架 refs）；扩展
         引用 = 无条件 ProjectReference（对齐 Permissions.Consumer 先例；部署脚本 -Cleanup 先清 refs 再构建
         的链路要求——raw Reference 依赖 refs 扩展 DLL 存在性会断链，2026-11-10 部署实证后改为本项目形态） -->
    <UseLocalFw Condition="'$(UseLocalFw)' == ''">true</UseLocalFw>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Condition="'$(UseLocalFw)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
    <Using Include="TKW.Framework.Domain.Interfaces" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测扩展——无条件 ProjectReference（对齐 Permissions.Consumer 先例；code-reviewer P0 #1 + 部署
         脚本 -Cleanup 先清 refs 再构建的链路要求——raw Reference 依赖 refs 扩展 DLL 存在性会断链）：
         WeChatChannels 双包（通道底座）+ Permissions.Abstractions（[RequirePermission] 特性）+ WeChatOperations
         主包 + Federation.WeChat（平台库）+ Federation.Abstractions（关注域契约）+ FeatureManagement（总开关 DB 化）。
         注：早期 raw Reference「编译引用集缺 MessageGateway.dll」的 DMP 漏列形态证据已存于 code-reviewer 审核报告
         （warn009-v0.10.0-code-review.md §3.1——实测编译引用集无 MessageGateway.dll）；本项目现为编译引用集含
         MessageGateway（ProjectReference 传递）的形态，DMP WebApi 复验仍为 WARN009 现象级最终观察点。 -->
    <ProjectReference Include="..\..\_Framework\WeChatChannels.Abstractions\TKWF.Ext.WeChatChannels.Abstractions.csproj" />
    <ProjectReference Include="..\..\_Framework\WeChatChannels\TKWF.Ext.WeChatChannels.csproj" />
    <ProjectReference Include="..\..\_Framework\Permissions.Abstractions\TKWF.Ext.Permissions.Abstractions.csproj" />
    <ProjectReference Include="..\..\_Framework\WeChatOperations\TKWF.Ext.WeChatOperations.csproj" />
    <ProjectReference Include="..\..\_Framework\Federation.WeChat\TKWF.Federation.WeChat.csproj" />
    <ProjectReference Include="..\..\_Framework\Federation.Abstractions\TKWF.Federation.Abstractions.csproj" />
    <ProjectReference Include="..\..\_Framework\FeatureManagement\TKWF.Ext.FeatureManagement.csproj" />
    <PackageReference Include="TKWF.Core" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.Domain" Condition="'$(UseLocalFw)' != 'true'" />
    <PackageReference Include="TKWF.CodeGeneration.Abstractions" Condition="'$(UseLocalFw)' != 'true'" />
    <Reference Include="TKWF.CodeGeneration.Abstractions" HintPath="$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll" Condition="'$(UseLocalFw)' == 'true' And Exists('$(_LocalFwRefsDir)TKWF.CodeGeneration.Abstractions.dll')" />
  </ItemGroup>

  <!-- V0.10.0：激活 SG1 分析器（纯 Analyzer 包）——SG1b 在消费方生成
       GeneratedControllerRegistrations（catalog/InterfaceNames），SG2a 同链路诊断 -->
  <ItemGroup>
    <PackageReference Include="TKWF.CodeGeneration" PrivateAssets="all" />
  </ItemGroup>

  <!-- SG1 生成文件排除物理编译（对齐扩展 csproj 惯例） -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(CompilerGeneratedFilesOutputPath)\**" />
  </ItemGroup>

  <!-- 消费方引用扩展 DLL：SG1b 在消费方推断 TUser 后生成控制器——
       CTRL006（业务 Service 建议 internal）/CTRL003 在消费方属预期（对齐 Permissions.Consumer 先例） -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);TKWF_SG1b_CTRL003;TKWF_SG1b_CTRL006;TKWF_SG1a_WRN_001;CS0436</NoWarn>
  </PropertyGroup>

</Project>